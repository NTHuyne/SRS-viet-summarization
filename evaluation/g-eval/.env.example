# Copy to .env and fill in your values

# Your Gemini API key (from Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=key

# Model to use (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# GEval settings (optional overrides)
GEVAL_N_SAMPLES=1        # 1 = no sampling (fast); set 20 for full GEval
GEVAL_CONCURRENCY=20     # parallel API calls
GEVAL_TEMPERATURE=0.0
